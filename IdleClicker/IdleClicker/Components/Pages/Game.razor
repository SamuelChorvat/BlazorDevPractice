@page "/game"
@rendermode InteractiveServer
@implements IDisposable
@using IdleClicker.Models
@inject Services.IGameService GameService

<h1>Idle Clicker - Azeroth Gold Gathering</h1>

<div style="position: absolute; top: 10px; right: 20px;">
    <button @onclick="GameService.SaveGame" style="margin-right:5px;">Save Game</button>
    <button @onclick="GameService.LoadGame">Load Game</button>
</div>

<p><strong>Gold:</strong> @GameService.Gold</p>

<button @onclick="GameService.GatherGold">Gather Gold</button>

<hr/>

<h3>Hire Units</h3>

@foreach (var unit in GameService.Units.Where(u => u.IsUnlocked))
{
    <div style="margin-bottom: 10px;">
        <strong>@unit.Name</strong> - Cost: @unit.Cost Gold - Generates: @unit.GoldPerSecond gold/sec
        <br />
        Owned: @unit.Quantity
        <br />
        <button @onclick="() => HireUnit(unit)" disabled="@(GameService.Gold < unit.Cost)">Hire @unit.Name</button>
    </div>
}

@code {
    private Action? _onChangeHandler;
    
    protected override void OnInitialized()
    {
        _onChangeHandler = () => InvokeAsync(StateHasChanged);
        GameService.OnChange += _onChangeHandler;
    }

    private void HireUnit(Unit unit)
    {
        GameService.HireUnit(unit);
    }

    public void Dispose()
    {
        if (_onChangeHandler != null)
        {
            GameService.OnChange -= _onChangeHandler;
        }
    }
}