@page "/game"
@rendermode InteractiveServer
@implements IDisposable
@using IdleClicker.Components.Layout
@using IdleClicker.Models
@using IdleClicker.Services
@using Unit = IdleClicker.Models.Unit
@inject IGameService GameService
@inject IToastService ToastService


<div style="position: absolute; top: 10px; right: 20px;">
    <div class="btn-group" role="group">
        <button class="btn btn-primary" @onclick="GameService.SaveGame">Save Game</button>
        <button class="btn btn-secondary" @onclick="GameService.LoadGame">Load Game</button>
    </div>
</div>

<div class="container mt-4">
    <h1 class="mt-3">Idle Clicker - Azeroth Gold Gathering</h1>

    <p><strong>Gold:</strong> @GameService.Gold</p>

    <button class="btn btn-warning mb-3" @onclick="GameService.GatherGold">Gather Gold</button>

    <hr/>

    @if (GameService.Units.Any(u => u is not HeroUnit && (u.CanHire(GameService.Gold) || u.Quantity > 0)))
    {
        <h3>Hire Units</h3>
        <div class="row">
            @foreach (var unit in GameService.Units.Where(u => u is not HeroUnit && u.IsUnlocked))
            {
                <div class="col-md-4 mb-3">
                    <div class="card h-100 fade-in" data-bs-toggle="tooltip" title="Click to view and hire this unit">
                        <div class="card-body">
                            <h5 class="card-title">
                                <i class="@unit.IconClass me-2"></i>@unit.Name
                            </h5>
                            <p class="card-text">
                                <strong>Cost:</strong> @unit.Cost Gold<br />
                                <strong>Generates:</strong> @unit.GoldPerSecond gold/sec<br />
                                <strong>Owned:</strong> @unit.Quantity
                            </p>
                            <button class="btn btn-success w-100"
                                    data-bs-toggle="tooltip"
                                    title="Cost: @unit.Cost | Produces @unit.GoldPerSecond/sec"
                                    @onclick="() => HireUnit(unit)"
                                    disabled="@(!unit.CanHire(GameService.Gold))">
                                <i class="bi bi-person-plus-fill me-1"></i>Hire @unit.Name
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    
    @if (GameService.Units.OfType<HeroUnit>().Any(h => h.CanHire(GameService.Gold) || h.Quantity > 0))
    {
        <h3 class="mt-5">Recruit Heroes</h3>
        <div class="row">
            @foreach (var hero in GameService.Units.OfType<HeroUnit>().Where(h => h.IsUnlocked))
            {
                <div class="col-md-4 mb-3">
                    <div class="card h-100 fade-in" data-bs-toggle="tooltip" title="Click to view and hire this hero">
                        <div class="card-body">
                            <h5 class="card-title">
                                <i class="@hero.IconClass me-2"></i>@hero.Name
                            </h5>
                            <p class="card-text">
                                <strong>Cost:</strong> @hero.Cost Gold<br />
                                <strong>Generates:</strong> @hero.GoldPerSecond gold/sec<br />
                            </p>
                            <p class="card-text">@(hero.Description)</p>
                            <button class="btn btn-success w-100"
                                    @onclick="() => HireUnit(hero)"
                                    disabled="@(!hero.CanHire(GameService.Gold))">
                                @(hero.Quantity > 0 ? "Recruited" : $"Hire {hero.Name}")
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    
</div>


@code {
    [CascadingParameter] 
    public MainLayout? Layout { get; set; }
    
    private Action? _onChangeHandler;
    
    protected override void OnInitialized()
    {
        _onChangeHandler = () => InvokeAsync(StateHasChanged);
        GameService.OnChange += _onChangeHandler;
    }

    private void HireUnit(Unit unit)
    {
        if (unit is HeroUnit hero && hero.Quantity == 0)
        {
            GameService.HireUnit(unit);
            ToastService.Show($"{hero.Name} has been recruited! {hero.Description}");
        }
        else
        {
            GameService.HireUnit(unit);
        }
    }

    public void Dispose()
    {
        if (_onChangeHandler != null)
        {
            GameService.OnChange -= _onChangeHandler;
        }
    }
}