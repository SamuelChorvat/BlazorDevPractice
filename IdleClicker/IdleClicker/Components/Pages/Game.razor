@page "/game"
@rendermode InteractiveServer
@implements IDisposable
@using IdleClicker.Models
@using IdleClicker.Services
@using IdleClicker.Components.Units
@inject IGameService GameService

<div style="position: absolute; top: 10px; right: 20px;">
    <div class="btn-group" role="group">
        <button class="btn btn-primary" @onclick="GameService.SaveGame">Save Game</button>
        <button class="btn btn-secondary" @onclick="GameService.LoadGame">Load Game</button>
    </div>
</div>

<div class="container mt-4 position-relative">
    
    <div class="floating-gold-layer">
        @foreach (var g in _floatingGolds.ToList())
        {
            <div @key="g.Id" class="floating-gold @g.ExtraClass" style="@g.InlineStyle">@g.Text</div>
        }
    </div>

    <h1 class="mt-3">Idle Clicker - Azeroth Gold Gathering</h1>

    <p><strong>Gold:</strong> @GameService.Gold</p>
    @if (GameService.PassiveGoldPerSecond > 0)
    {
        <p class="text-muted">
            <i class="bi bi-clock me-1" title="Passive income from hired units"></i>
            Passive income: <strong>@GameService.PassiveGoldPerSecond</strong> gold/sec
        </p>   
    }
    <div class="d-flex align-items-center mb-3 gap-3">
        <button class="btn btn-warning" @onclick="GameService.GatherGold">Gather Gold</button>
        @if (_showCombo && GameService.ClickComboCount > 1)
        {
            <div class="text-danger fw-bold @(_comboClass)">Combo x@(GameService.ClickComboCount)</div>
        }
    </div>

    <hr/>

    @if (GameService.Units.Any(u => u is not HeroUnit && (u.CanHire(GameService.Gold) || u.Quantity > 0)))
    {
        <h3>Hire Units</h3>
        <div class="row">
            @foreach (var unit in GameService.Units.Where(u => u is not HeroUnit && u.IsUnlocked))
            {
                <div class="col-md-4 mb-3">
                    <UnitCard Unit="unit" />
                </div>
            }
        </div>
    }

    @if (GameService.Units.OfType<HeroUnit>().Any(h => h.CanHire(GameService.Gold) || h.Quantity > 0))
    {
        <h3 class="mt-5">Recruit Heroes</h3>
        <div class="row">
            @foreach (var hero in GameService.Units.OfType<HeroUnit>().Where(h => h.IsUnlocked))
            {
                <div class="col-md-4 mb-3">
                    <HeroUnitCard Unit="hero" />
                </div>
            }
        </div>
    }

</div>


@code {
    private Action? _onChangeHandler;
    private readonly List<FloatingGoldEffect> _floatingGolds = [];
    private bool _showCombo;
    private CancellationTokenSource? _comboCancelToken;
    private string _comboClass = "";
    
    protected override void OnInitialized()
    {
        _onChangeHandler = () => InvokeAsync(StateHasChanged);
        GameService.OnChange += _onChangeHandler;
        GameService.OnGoldEarned += ShowFloatingGold;
        GameService.OnManualGoldEarned += HandleCombo;
    }

    private void ShowFloatingGold(int amount)
    {
        var random = Random.Shared;
        var left = random.Next(40, 60);
        var top = random.Next(30, 50);

        var extraClass = amount switch
        {
            >= 1000 => "gold-epic",
            >= 500 => "gold-rare",
            >= 100 => "gold-uncommon",
            _ => ""
        };

        var effect = new FloatingGoldEffect
        {
            Text = $"+{amount} gold",
            InlineStyle = $"left: {left}%; top: {top}%;",
            ExtraClass = extraClass
        };

        _floatingGolds.Add(effect);
        StateHasChanged();

        _ = Task.Delay(1000).ContinueWith(_ =>
        {
            _floatingGolds.RemoveAll(e => e.Id == effect.Id);
            InvokeAsync(StateHasChanged);
        });
    }
    
    private void HandleCombo(int gold)
    {
        _showCombo = true;
        
        _comboClass = "";
        StateHasChanged();
        
        _ = Task.Delay(1).ContinueWith(_ =>
        {
            _comboClass = "combo-label";
            InvokeAsync(StateHasChanged);
        });

        _comboCancelToken?.Cancel();
        _comboCancelToken = new CancellationTokenSource();
        var token = _comboCancelToken.Token;

        _ = Task.Delay(1600, token).ContinueWith(t =>
        {
            if (t.IsCanceled) return;
            _showCombo = false;
            InvokeAsync(StateHasChanged);
        }, token);

        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        if (_onChangeHandler != null)
        {
            GameService.OnChange -= _onChangeHandler;
        }
        GameService.OnGoldEarned -= ShowFloatingGold;
    }
}